# Two modes (Vite bakes these at start/build — restart dev / rebuild after changes):
#  LOCAL (`npm run dev`): leave VITE_API_URL empty -> same-origin calls via
#    the vite proxy (also avoids https->http mixed-content blocks).
#  HOSTED (Vercel etc.): VITE_API_URL=https://<tunnel-or-pi-url>, no slash.
VITE_API_URL=
# Same value as the Pi's API_KEY. Empty = backend auth open (local dev).
VITE_API_KEY=
