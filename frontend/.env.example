# Deployed-frontend config (copy to .env for local dev; set as env vars on
# your static host — Vercel/Netlify "Environment Variables" — then rebuild).
# The browser calls the Pi backend directly, so this URL must be reachable
# from YOUR DEVICE (Cloudflare Tunnel https URL recommended, see
# docs/REMOTE_ARCHITECTURE.md). No trailing slash.
VITE_API_URL=http://127.0.0.1:8000
# Same value as the Pi's API_KEY. Empty = backend auth open (local dev).
VITE_API_KEY=
